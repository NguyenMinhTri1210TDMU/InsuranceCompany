{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },

  "AllowedHosts": "*",

  // ====================== SPRING & EUREKA ======================
  "spring": {
    "application": {
      "name": "auth-service" // Nên dùng kebab-case
    }
  },

  "eureka": {
    "client": {
      "serviceUrl": "http://localhost:8761/eureka/",
      "shouldRegisterWithEureka": true,
      "shouldFetchRegistry": false, // AuthService thường không cần fetch
      "validateCertificates": false
    },
    "instance": {
      "port": 0, // 0 = dùng port ngẫu nhiên (tốt khi scale)
      "preferIpAddress": true,
      "ipAddress": "127.0.0.1"
    }
  },
  // ============================================================

  "AppSettings": {
    "Secret": "THIS_IS_A_RANDOM_SECRET_2e7a1e80-16ee-4e52-b5c6-5e8892453459",
    "AllowedAuthOrigins": [
      "http://localhost:8080",
      "http://localhost",
      "http://localhost:5081",
      "https://localhost:8080",
      "https://localhost:5081"
    ]
  }
}