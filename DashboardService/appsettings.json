{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },

  "AllowedHosts": "*",

  // ====================== RABBITMQ ======================
  "RabbitMqOptions": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "guest",
    "Password": "guest",
    "RequestTimeout": 30
  },
  // =====================================================

  "ConnectionStrings": {
    "ElasticSearchConnection": "http://localhost:9200"
  },

  // ====================== EUREKA ======================
  "Spring": {
    "Application": {
      "Name": "dashboard-service" // Nên dùng kebab-case
    }
  },

  "Eureka": {
    "Client": {
      "ServiceUrl": "http://localhost:8761/eureka/",
      "ShouldRegisterWithEureka": true,
      "ShouldFetchRegistry": false,
      "ValidateCertificates": false
    },
    "Instance": {
      "Port": 5035,
      "HostName": "localhost",
      "PreferIpAddress": true,
      "IpAddress": "127.0.0.1"
    }
  }
  // ====================================================
}