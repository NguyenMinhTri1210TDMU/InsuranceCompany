{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },

  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": "User ID=lab_user;Password=lab_pass;Database=lab_netmicro_pricing;Host=localhost;Port=5432"
  },

  // ====================== EUREKA ======================
  "Spring": {
    "Application": {
      "Name": "pricing-service" // Đã đúng kebab-case
    }
  },

  "Eureka": {
    "Client": {
      "ServiceUrl": "http://localhost:8761/eureka/",
      "ShouldRegisterWithEureka": true,
      "ShouldFetchRegistry": false, // PricingService thường không cần discover nhiều
      "ValidateCertificates": false
    },
    "Instance": {
      "Port": 5040,
      "HostName": "localhost",
      "PreferIpAddress": true,
      "IpAddress": "127.0.0.1"
    }
  }
  // ===================================================
}