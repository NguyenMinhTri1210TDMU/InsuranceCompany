{
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": "THIS IS A SECRET",
    "PgConnection": "User ID=lab_user;Password=lab_pass;Database=lab_netmicro_payments;Host=localhost;Port=5432"
  },

  "BackgroundJobs": {
    "HangfireConnectionStringName": "User ID=lab_user;Password=lab_pass;Database=lab_netmicro_jobs;Host=localhost;Port=5432",
    "InPaymentFileFolder": "/mnt/bigdisk/dotnetpoc/testcases"
  },

  "spring": {
    "application": {
      "name": "payment-service" // Tên service hiển thị trên Eureka Dashboard
    }
  },

  "eureka": {
    "client": {
      "serviceUrl": "http://localhost:8761/eureka/", // Địa chỉ Eureka Server của bạn
      "shouldRegisterWithEureka": true,
      "shouldFetchRegistry": false, // Thường để false nếu service này chỉ register, không discover
      "validateCertificates": false
    },
    "instance": {
      "port": 0, // 0 = dùng port ngẫu nhiên (khuyến nghị khi chạy nhiều instance)
      "preferIpAddress": true,
      "ipAddress": "127.0.0.1", // Hoặc để "" để tự động lấy IP
      "instanceId": "${spring.application.name}:${random.value}" // Tránh trùng instanceId khi chạy nhiều bản
    }
  }
}