{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },

  "AllowedHosts": "*",

  // ====================== EUREKA CONFIGURATION ======================
  "Spring": {
    "Application": {
      "Name": "policy-search-service" // Nên dùng kebab-case
    }
  },

  "Eureka": {
    "Client": {
      "ServiceUrl": "http://localhost:8761/eureka/",
      "ShouldRegisterWithEureka": true,
      "ShouldFetchRegistry": false, // PolicySearchService thường chỉ register
      "ValidateCertificates": false
    },
    "Instance": {
      "Port": 5065,
      "HostName": "localhost",
      "PreferIpAddress": true,
      "IpAddress": "127.0.0.1"
    }
  },
  // =================================================================

  "ConnectionStrings": {
    "ElasticSearchConnection": "http://localhost:9200"
  }
}