{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },

  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": "User ID=lab_user;Password=lab_pass;Database=lab_netmicro_policy;Host=localhost;Port=5432"
  },

  // URI để gọi PricingService (nếu dùng HttpClient trực tiếp)
  "PricingServiceUri": "http://PricingService/api/pricing",

  // ====================== EUREKA CONFIGURATION ======================
  "Spring": {
    "Application": {
      "Name": "policy-service" // Nên dùng kebab-case
    }
  },

  "Eureka": {
    "Client": {
      "ServiceUrl": "http://localhost:8761/eureka/",
      "ShouldRegisterWithEureka": true,
      "ShouldFetchRegistry": true, // PolicyService thường cần discover các service khác (như PricingService)
      "ValidateCertificates": false
    },
    "Instance": {
      "Port": 5050,
      "HostName": "localhost",
      "PreferIpAddress": true,
      "IpAddress": "127.0.0.1"
    }
  }
  // =================================================================
}