{
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  },

  "Settings": {
    "UseInMemoryDatabase": true
  },

  "AllowedHosts": "*",

  // ==================== EUREKA CONFIGURATION ====================
  "Spring": {
    "Application": {
      "Name": "product-service" // Nên dùng kebab-case (chữ thường + gạch ngang)
    }
  },

  "Eureka": {
    "Client": {
      "ServiceUrl": "http://localhost:8761/eureka/", // Địa chỉ Eureka Server
      "ShouldRegisterWithEureka": true,
      "ShouldFetchRegistry": false, // Để false nếu service này chỉ register, không cần discover
      "ValidateCertificates": false
    },
    "Instance": {
      "Port": 5030, // Port cố định bạn muốn dùng
      "HostName": "localhost",
      "PreferIpAddress": true, // Khuyến nghị dùng IP thay vì hostname
      "IpAddress": "127.0.0.1"
    }
  }
  // ============================================================
}