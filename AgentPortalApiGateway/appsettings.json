{
  "Logging": {
    "IncludeScopes": true,
    "LogLevel": {
      "Default": "Information",
      "System": "Warning",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Newtonsoft": "Warning"
    }
  },

  "AllowedHosts": "*",

  // ==================== SPRING & EUREKA ====================
  "Spring": {
    "Application": {
      "Name": "agent-portal-api-gateway" // Nên dùng kebab-case
    }
  },

  "Eureka": {
    "Client": {
      "ServiceUrl": "http://localhost:8761/eureka/",
      "ShouldRegisterWithEureka": false, // Bạn muốn tắt → giữ nguyên
      "ShouldFetchRegistry": true, // Gateway nên fetch registry để route đến các service
      "ValidateCertificates": false
    },
    "Instance": {
      "Port": 0, // Dùng port ngẫu nhiên (khuyến nghị cho Gateway)
      "PreferIpAddress": true,
      "IpAddress": "127.0.0.1"
    }
  },
  // =======================================================

  "AppSettings": {
    "AllowedChatOrigins": [
      "http://localhost:8080",
      "http://localhost",
      "http://localhost:5081",
      "https://localhost:8080",
      "https://localhost:5081"
    ]
  }
}